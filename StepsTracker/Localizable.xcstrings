    "StepsTracker reads step data from Health to show your daily progress and weekly activity. You can change this later in Settings." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StepsTracker lee tus pasos de Salud para mostrar tu progreso diario y actividad semanal. Puedes cambiarlo después en Ajustes."
          }
        }
      }
    },
    "StepsTracker reads your step count from Apple Health to show your progress. Your health data is not shared with third parties." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StepsTracker lee tus pasos de Salud de Apple para mostrar tu progreso. Tus datos de salud no se comparten con terceros."
          }
        }
      }
    },
    "Tap the same day to deselect" : {
      "extractionState" : "manual",
